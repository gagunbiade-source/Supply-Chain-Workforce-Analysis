import psycopg2
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

conn = psycopg2.connect(
    host="localhost",
    database="postgres",
    user="postgres",
    password="postgres"
)

df = pd.read_sql("SELECT * FROM advanced_workforce_churn;", conn)
conn.close()

print("Rows loaded:", len(df))
print(df.head(3))

# Overtime/Engagement risk bands
df["overtime_band"] = pd.cut(
    df["monthly_avg_overtime_hours"],
    bins=[-1, 10, 20, 35, 100],
    labels=["0-10", "11-20", "21-35", "36+"]
)

df["engagement_band"] = pd.cut(
    df["engagement_survey_score"],
    bins=[0, 3, 5, 7, 10],
    labels=["1-3 (Low)", "4-5", "6-7", "8-10 (High)"]
)

# Risk matrix = churn rate (%)
risk_matrix = (
    df.pivot_table(
        index="engagement_band",
        columns="overtime_band",
        values="left_company",
        aggfunc="mean"
    ) * 100
).round(1)

print("\nRisk Matrix (Attrition %):")
print(risk_matrix)

# Optional threshold check
high_risk = df[(df["monthly_avg_overtime_hours"] > 35) & (df["engagement_survey_score"] < 5)]
baseline = df["left_company"].mean()
high_risk_rate = high_risk["left_company"].mean() if len(high_risk) else 0
multiplier = (high_risk_rate / baseline) if baseline > 0 else 0

print("\nThreshold Segment Stats:")
print("Employees in threshold group:", len(high_risk))
print(f"Baseline churn rate: {baseline*100:.1f}%")
print(f"Threshold churn rate: {high_risk_rate*100:.1f}%")
print(f"Risk multiplier: {multiplier:.2f}x")

# Plot risk matrix heatmap
plt.figure(figsize=(9, 6))
sns.heatmap(
    risk_matrix,
    annot=True,
    fmt=".1f",
    cmap="Reds",
    linewidths=0.5,
    cbar_kws={"label": "Attrition Rate (%)"}
)
plt.title("Predictive Workforce Retention Risk Matrix")
plt.xlabel("Monthly Avg Overtime Hours")
plt.ylabel("Engagement Score Band")
plt.tight_layout()
plt.savefig("churn_heatmap.png", dpi=300, bbox_inches="tight")
print("\nSaved: churn_heatmap.png")
plt.show()

