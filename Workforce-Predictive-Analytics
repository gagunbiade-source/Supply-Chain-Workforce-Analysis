-- Ensure table/data exists first by running init.sql

-- 1) Churn summary
SELECT
  Left_Company,
  COUNT(*) AS employee_count
FROM advanced_workforce_churn
GROUP BY Left_Company
ORDER BY Left_Company;

-- 2) Average overtime by employee status
SELECT
  CASE WHEN Left_Company = 1 THEN 'Left' ELSE 'Stayed' END AS employee_status,
  ROUND(AVG(Monthly_Avg_Overtime_Hours), 2) AS avg_overtime_hours,
  COUNT(*) AS employee_count
FROM advanced_workforce_churn
GROUP BY Left_Company
ORDER BY Left_Company DESC;

-- 3) Average engagement by employee status
SELECT
  CASE WHEN Left_Company = 1 THEN 'Left' ELSE 'Stayed' END AS employee_status,
  ROUND(AVG(Engagement_Survey_Score), 2) AS avg_engagement_score
FROM advanced_workforce_churn
GROUP BY Left_Company
ORDER BY Left_Company DESC;

-- 4) Correlation of numeric factors with attrition
SELECT factor, correlation
FROM (
  SELECT 'Monthly_Avg_Overtime_Hours' AS factor,
         ROUND(CORR(Left_Company::numeric, Monthly_Avg_Overtime_Hours::numeric)::numeric, 4) AS correlation
  FROM advanced_workforce_churn
  UNION ALL
  SELECT 'Last_Performance_Rating',
         ROUND(CORR(Left_Company::numeric, Last_Performance_Rating::numeric)::numeric, 4)
  FROM advanced_workforce_churn
  UNION ALL
  SELECT 'Tenure_Months',
         ROUND(CORR(Left_Company::numeric, Tenure_Months::numeric)::numeric, 4)
  FROM advanced_workforce_churn
  UNION ALL
  SELECT 'Engagement_Survey_Score',
         ROUND(CORR(Left_Company::numeric, Engagement_Survey_Score::numeric)::numeric, 4)
  FROM advanced_workforce_churn
  UNION ALL
  SELECT 'Hourly_Rate',
         ROUND(CORR(Left_Company::numeric, Hourly_Rate::numeric)::numeric, 4)
  FROM advanced_workforce_churn
) t
ORDER BY ABS(correlation) DESC;

-- 5) Attrition rate by department
SELECT
  Department,
  COUNT(*) AS total_employees,
  SUM(Left_Company) AS employees_left,
  ROUND(100.0 * AVG(Left_Company), 2) AS attrition_rate_pct
FROM advanced_workforce_churn
GROUP BY Department
ORDER BY attrition_rate_pct DESC, total_employees DESC;

-- 6) Threshold proof: >35 overtime and engagement <5
WITH base AS (
  SELECT AVG(Left_Company::numeric) AS baseline_rate
  FROM advanced_workforce_churn
),
threshold_group AS (
  SELECT
    COUNT(*) AS threshold_count,
    AVG(Left_Company::numeric) AS threshold_rate
  FROM advanced_workforce_churn
  WHERE Monthly_Avg_Overtime_Hours > 35
    AND Engagement_Survey_Score < 5
)
SELECT
  (SELECT COUNT(*) FROM advanced_workforce_churn) AS total_employees,
  threshold_count AS threshold_employees,
  ROUND(100 * baseline_rate, 2) AS baseline_attrition_pct,
  ROUND(100 * threshold_rate, 2) AS threshold_attrition_pct,
  ROUND(threshold_rate / NULLIF(baseline_rate, 0), 2) AS risk_multiplier_x
FROM base, threshold_group;

-- 7) Risk-tier segmentation with recommended action
WITH scored AS (
  SELECT
    Employee_ID,
    Department,
    Monthly_Avg_Overtime_Hours,
    Engagement_Survey_Score,
    Left_Company,
    CASE
      WHEN Monthly_Avg_Overtime_Hours > 35 AND Engagement_Survey_Score < 5 THEN 'High'
      WHEN Monthly_Avg_Overtime_Hours > 25 AND Engagement_Survey_Score <= 5 THEN 'Medium'
      ELSE 'Low'
    END AS risk_tier
  FROM advanced_workforce_churn
)
SELECT
  risk_tier,
  COUNT(*) AS employees,
  SUM(Left_Company) AS employees_left,
  ROUND(100.0 * AVG(Left_Company::numeric), 2) AS attrition_rate_pct,
  CASE
    WHEN risk_tier = 'High' THEN 'Immediate manager intervention (<=7 days)'
    WHEN risk_tier = 'Medium' THEN 'Workload rebalance + pulse check'
    ELSE 'Standard retention monitoring'
  END AS recommended_action
FROM scored
GROUP BY risk_tier
ORDER BY CASE risk_tier WHEN 'High' THEN 1 WHEN 'Medium' THEN 2 ELSE 3 END;

-- 8) Top at-risk active employees (left_company = 0) for proactive follow-up
SELECT
  Employee_ID,
  Department,
  Monthly_Avg_Overtime_Hours,
  Engagement_Survey_Score,
  CASE
    WHEN Monthly_Avg_Overtime_Hours > 35 AND Engagement_Survey_Score < 5 THEN 'High'
    WHEN Monthly_Avg_Overtime_Hours > 25 AND Engagement_Survey_Score <= 5 THEN 'Medium'
    ELSE 'Low'
  END AS risk_tier,
  CASE
    WHEN Monthly_Avg_Overtime_Hours > 35 AND Engagement_Survey_Score < 5 THEN 95
    WHEN Monthly_Avg_Overtime_Hours > 25 AND Engagement_Survey_Score <= 5 THEN 75
    WHEN Monthly_Avg_Overtime_Hours > 20 AND Engagement_Survey_Score <= 6 THEN 60
    ELSE 25
  END AS risk_score
FROM advanced_workforce_churn
WHERE Left_Company = 0
ORDER BY risk_score DESC, Monthly_Avg_Overtime_Hours DESC, Engagement_Survey_Score ASC
LIMIT 15;


