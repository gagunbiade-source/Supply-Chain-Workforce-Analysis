-- Advanced Workforce Churn Dataset (250 rows)

DROP TABLE IF EXISTS advanced_workforce_churn;

CREATE TABLE advanced_workforce_churn (
    Employee_ID INT PRIMARY KEY,
    Department VARCHAR(50),
    Monthly_Avg_Overtime_Hours NUMERIC(5,1),
    Last_Performance_Rating INT,
    Tenure_Months INT,
    Engagement_Survey_Score INT,
    Hourly_Rate NUMERIC(8,2),
    Left_Company INT
);

INSERT INTO advanced_workforce_churn (
    Employee_ID,
    Department,
    Monthly_Avg_Overtime_Hours,
    Last_Performance_Rating,
    Tenure_Months,
    Engagement_Survey_Score,
    Hourly_Rate,
    Left_Company
)
SELECT
    employee_id,
    department,
    overtime_hours::NUMERIC(5,1),
    performance_rating,
    tenure_months,
    engagement_score,
    hourly_rate,
    CASE
        WHEN overtime_hours >= 35 AND engagement_score <= 4 THEN CASE WHEN random() < 0.90 THEN 1 ELSE 0 END
        WHEN overtime_hours >= 25 AND engagement_score <= 5 THEN CASE WHEN random() < 0.75 THEN 1 ELSE 0 END
        WHEN overtime_hours >= 20 AND engagement_score <= 6 THEN CASE WHEN random() < 0.55 THEN 1 ELSE 0 END
        WHEN engagement_score <= 3 THEN CASE WHEN random() < 0.65 THEN 1 ELSE 0 END
        ELSE CASE WHEN random() < 0.08 THEN 1 ELSE 0 END
    END AS Left_Company
FROM (
    SELECT
        gs AS employee_id,
        (ARRAY[
            'Warehouse',
            'Fulfillment',
            'Shipping',
            'Customer Support',
            'Operations',
            'HR',
            'Finance',
            'IT'
        ])[floor(random()*8 + 1)] AS department,
        ROUND(
            (
                CASE
                    WHEN random() < 0.20 THEN 25 + random()*25
                    ELSE random()*25
                END
            )::numeric,
            1
        ) AS overtime_hours,
        CASE
            WHEN random() < 0.10 THEN 1
            WHEN random() < 0.25 THEN 2
            WHEN random() < 0.55 THEN 3
            WHEN random() < 0.85 THEN 4
            ELSE 5
        END AS performance_rating,
        FLOOR(random()*120 + 1)::INT AS tenure_months,
        CASE
            WHEN random() < 0.15 THEN FLOOR(random()*3 + 1)
            WHEN random() < 0.35 THEN FLOOR(random()*3 + 4)
            ELSE FLOOR(random()*4 + 7)
        END::INT AS engagement_score,
        ROUND((18 + random()*32)::NUMERIC, 2) AS hourly_rate
    FROM generate_series(1001, 1250) gs
) x;

-- Quick verification output
SELECT COUNT(*) AS total_rows FROM advanced_workforce_churn;

SELECT
    Left_Company,
    COUNT(*) AS employee_count
FROM advanced_workforce_churn
GROUP BY Left_Company
ORDER BY Left_Company;


